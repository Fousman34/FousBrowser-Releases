# ===== Rust / Tauri =====
target/
**/target/
*.rs.bk
*.pdb

# ===== Node / фронтенд =====
node_modules/
launcher/dist/
launcher/.svelte-kit/
launcher/build/
npm-debug.log*
pnpm-debug.log*
package-lock.json.bak

# ===== Скачанные движки браузеров (не в git, ставятся извне) =====
browsers/*
!browsers/.gitkeep

# ===== Зашифрованные профили пользователей — НИКОГДА в git =====
profiles/*
!profiles/.gitkeep

# ===== Секреты и ключи =====
.env
.env.local
*.pem
*.pfx
*.p12
*.key
*.jks
!launcher/resources/keys/*.asc

# ===== Локальные артефакты сборки установщиков =====
launcher/src-tauri/target/release/bundle/
dist/
*.log

# ===== ОС / IDE =====
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ===== Публичный ключ проверки подписи релизов движка =====
# Приватный ключ в репозиторий не попадает никогда: он хранится только
# в секретах GitHub Actions (GPG_PRIVATE_KEY).
!launcher/src-tauri/resources/keys/*.asc
core-tests.log

# ===== Манифесты релизов движка =====
# Сам движок в git не попадает (сотни мегабайт), но манифест, список сумм и
# подпись обязаны быть в репозитории: из них собирается релиз и по ним
# проверяется подлинность скачанного архива.
!browsers/antidetect/
!browsers/antidetect/*/
!browsers/antidetect/*/release.json
!browsers/antidetect/*/SHA256SUMS
!browsers/antidetect/*/SHA256SUMS.asc
