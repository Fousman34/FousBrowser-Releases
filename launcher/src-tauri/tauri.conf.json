{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FousBrowser",
  "version": "0.3.0",
  "identifier": "com.fousman34.fousbrowser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "FousBrowser",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Fousman34",
    "category": "Utility",
    "shortDescription": "FousBrowser launcher",
    "longDescription": "Управление зашифрованными профилями браузеров: движки Normal и Antidetect, прокси на профиль, проверка обновлений.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    },
    "createUpdaterArtifacts": false
  }
}
