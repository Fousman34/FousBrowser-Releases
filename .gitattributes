# Правила работы с переводами строк.
#
# Зачем это нужно: контрольные суммы и GPG-подписи проверяются **побайтово**.
# Если git при checkout заменит LF на CRLF (а на Windows-раннере GitHub это
# происходит), подписанные данные изменятся и подпись перестанет сходиться —
# ровно так упал CI: тест проверки подписи проходил локально и падал на раннере.
#
# Поэтому все файлы, байты которых имеют смысл, объявлены нетекстовыми:
# git их не трогает.

# Списки контрольных сумм и подписи релизов движка
browsers/antidetect/** -text

# Тестовые данные проверки подписи
launcher/src-tauri/tests/fixtures/** -text

# Публичные ключи проверки
launcher/src-tauri/resources/keys/** -text

# Списки сумм в любом месте репозитория
SHA256SUMS -text
SHA256SUMS.asc -text

# Обычные текстовые файлы: в репозитории LF, на диске — как принято в системе
* text=auto eol=lf
*.png binary
*.ico binary
*.ttf binary
*.icns binary
*.zip binary
